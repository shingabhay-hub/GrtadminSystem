# GRT Admin API Environment Variables

# Server configuration
NODE_ENV=development
PORT=5000

# Database (optional - for production use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grt_admin
DB_USER=admin
DB_PASSWORD=your-password

# JWT (if using JWT instead of sessions)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=3600

# CORS
CORS_ORIGIN=http://localhost:3000,https://shingabhay-hub.github.io

# Logging
LOG_LEVEL=info

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@grt-admin.com

# Slack (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# AWS (for S3 backups)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=grt-admin-backups

# Azure (for storage)
AZURE_STORAGE_ACCOUNT=your-account
AZURE_STORAGE_KEY=your-key

# Monitoring
MONITORING_INTERVAL=5000
ALERT_THRESHOLD_CPU=85
ALERT_THRESHOLD_MEMORY=80
ALERT_THRESHOLD_DISK=90
