# GRT Admin Console - Docker Compose Environment Variables
# Copy this file to .env and customize for your environment

# ==== Application Environment ====
NODE_ENV=production
TZ=UTC

# ==== Frontend (Nginx) ====
FRONTEND_PORT=80
FRONTEND_SECURE_PORT=443

# ==== Backend (Express.js) ====
BACKEND_PORT=5000
PORT=5000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost,http://frontend,https://shingabhay-hub.github.io
JWT_SECRET=grt-admin-secret-key-change-in-production-12345678

# ==== Database (MongoDB) ====
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_USER=grt_user
MONGO_PASSWORD=grt_password
MONGO_DATABASE=grt_admin
MONGO_PORT=27017

# ==== Cache (Redis) ====
REDIS_PASSWORD=redis-secure-password-change-me
REDIS_PORT=6379

# ==== Monitoring (Prometheus) ====
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# ==== Visualization (Grafana) ====
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana-admin-password-change-me
GRAFANA_PORT=3000

# ==== Logging (Elasticsearch) ====
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HEAP_SIZE=512m

# ==== Reverse Proxy (Traefik) ====
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_SECURE_PORT=8443
TRAEFIK_DOMAIN=localhost
TRAEFIK_ACME_EMAIL=admin@example.com

# ==== Email Notifications ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@grt-admin.com

# ==== Slack Integration ====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#alerts
SLACK_USERNAME=GRT Admin Bot

# ==== AWS Integration (for S3 backups) ====
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=grt-admin-backups

# ==== Azure Integration ====
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ==== Backup Configuration ====
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_DESTINATION=s3://grt-admin-backups

# ==== Disaster Recovery ====
DR_ENABLED=true
RTO_MINUTES=15
RPO_MINUTES=5
FAILOVER_TIMEOUT=300

# ==== Alerts & Monitoring ====
ALERT_THRESHOLD_CPU=85
ALERT_THRESHOLD_MEMORY=80
ALERT_THRESHOLD_DISK=90
MONITORING_INTERVAL_SECONDS=30

# ==== Security ====
ENABLE_MFA=true
SESSION_TIMEOUT_MINUTES=60
PASSWORD_MIN_LENGTH=12
REQUIRE_UPPERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true

# ==== Logging & Auditing ====
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=365
LOG_LEVEL=info
DEBUG=false

# ==== Rate Limiting ====
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT=1000

# ==== CORS Configuration ====
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ==== Docker Image Versions ====
NGINX_VERSION=alpine
NODE_VERSION=18-alpine
MONGO_VERSION=6.0-alpine
REDIS_VERSION=7-alpine
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
ELASTICSEARCH_VERSION=8.0.0
TRAEFIK_VERSION=latest
